{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Energia API (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "env": {
        "ENVIRONMENT": "local",
        "AUTH_DISABLED": "true"
      },
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
