# Copie para .env e ajuste. Nunca versione o .env.

# local | prod
AMBIENTE=local

# Postgres (aceita postgresql:// ou postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://warehouse:warehouse@localhost:5433/warehouse

# Portal (energia-web): links dos e-mails e revalidação do ISR
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=troque-por-um-segredo-longo
REVALIDATE_TIMEOUT_SEGUNDOS=5

# Cognito (validação dos JWT de /v1/admin/*)
COGNITO_REGION=sa-east-1
COGNITO_USER_POOL_ID=
# Lista separada por vírgula: client do energia-web e client M2M do energia-data
COGNITO_APP_CLIENT_IDS=

# Só funciona com AMBIENTE=local (a API não sobe com essa flag em prod)
AUTH_DESATIVADA=true

# E-mail (SES só é usado com AMBIENTE=prod; localmente o e-mail vai para o log)
EMAIL_REMETENTE=Energia <nao-responda@exemplo.com.br>
SES_REGION=sa-east-1

# Cache em memória das rotas públicas (segundos) e limite da newsletter (por IP, por instância)
CACHE_TTL_SEGUNDOS=300
NEWSLETTER_LIMITE_POR_MINUTO=5
# true só atrás de um load balancer que acrescenta o IP do cliente ao X-Forwarded-For (ALB)
CONFIAR_X_FORWARDED_FOR=false
